# ============================================================
# DENTAL WHATSAPP AGENT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# --------------------------
# SERVER
# --------------------------
NODE_ENV=development
PORT=5000
BASE_URL=https://your-domain.com

# --------------------------
# DATABASE (MongoDB)
# --------------------------
MONGODB_URI=your_mongodb_connection_string

# --------------------------
# JWT AUTH
# --------------------------
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# --------------------------
# WHATSAPP - META CLOUD API
# (Get from developers.facebook.com)
# --------------------------
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token
DEFAULT_WHATSAPP_NUMBER=+923372113410

# --------------------------
# WHATSAPP - TWILIO (Alternative)
# Uncomment to use Twilio instead of Meta
# --------------------------
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --------------------------
# AI - CLAUDE / ANTHROPIC
# (Get from console.anthropic.com)
# --------------------------
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --------------------------
# AI - OPENAI (Alternative)
# --------------------------
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o

# --------------------------
# GOOGLE CALENDAR API
# (Get from console.cloud.google.com)
# --------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# --------------------------
# EMAIL (for admin notifications)
# --------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@yourclinic.com

# --------------------------
# SPEECH TO TEXT (Whisper)
# Uses OpenAI Whisper for voice note transcription
# --------------------------
ENABLE_VOICE_NOTES=true
OPENAI_API_KEY_WHISPER=sk-your-openai-key-for-whisper

# --------------------------
# RATE LIMITING
# --------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --------------------------
# REMINDER SETTINGS
# --------------------------
REMINDER_HOURS_BEFORE=24
FOLLOWUP_HOURS_AFTER=2

# --------------------------
# FRONTEND URL (for CORS)
# --------------------------
FRONTEND_URL=http://localhost:3000
